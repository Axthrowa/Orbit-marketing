# Etkileşim Takip — ortam değişkenleri örneği (created by axthrowa)
#
# Uygulama .env dosyasını KENDİSİ OKUMAZ; bunlar işlem ortam değişkenleridir. Geliştirmede
# PowerShell'de `$env:AD = "değer"` ile ayarlayın. Hiçbiri zorunlu değildir.
# GERÇEK SIR DEĞERLERİNİ BU DOSYAYA VEYA DEPOYA YAZMAYIN.

# Veri klasörü (veritabanı, günlük, tarayıcı profili, yedekler).
# Varsayılan: %LOCALAPPDATA%\EtkilesimTakip
ETKILESIM_DATA_DIR=

# Sağlayıcı modu: "real" (varsayılan) veya "mock". mock modunda hiçbir platforma bağlanılmaz,
# ölçümler sahte üretilir ve arayüzde "MOCK DATA" rozeti görünür. Yalnız geliştirme/demo içindir.
ETKILESIM_PROVIDER_MODE=real

# Motorun yeri (Tauri kabuğu için). Sıra: ETKILESIM_ENGINE → exe yanındaki etkilesim-engine.exe →
# ETKILESIM_PYTHON (-m etkilesim) → debug derlemede engine\.venv\Scripts\python.exe.
ETKILESIM_ENGINE=
ETKILESIM_PYTHON=

# Sırlar normalde işletim sisteminin kimlik deposunda (Windows Kimlik Yöneticisi) tutulur ve
# Bağlantılar & ayarlar ekranından girilir. Aşağıdakiler yalnızca başsız/CI ortamı için yedek
# kaynaktır; boş bırakın.
ETKILESIM_TELEGRAM_TOKEN=
ETKILESIM_SMTP_PASSWORD=
ETKILESIM_TEAMS_WEBHOOK=

# Kabuk tarafından her çağrıda ayarlanır; elle ayarlamayın:
#   ETKILESIM_ADMIN_PIN  — yönetici PIN'i yalnızca bu değişkenle motora gider (argv/günlük yok)
#   ETKILESIM_PARENT_PID — zamanlayıcı, uygulama kapanınca kendini sonlandırmak için izler
